[Unit]
Description=RichRoad Gin Server (en-tech-2)
After=network.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/richRoad-en-tech-2/server
ExecStart=/www/wwwroot/richRoad-en-tech-2/server/richroad-en-tech-2-server
Restart=always
RestartSec=5
User=root
Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
